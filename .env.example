# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and loaded automatically by main.py (via python-dotenv).

# Your Mistral API key. When set, STARK-QA generates answers with the Mistral
# LLM; when unset, it uses the local extractive fallback.
MISTRAL_API_KEY=

# Optional: override the Mistral model id (defaults to config.MISTRAL_MODEL,
# i.e. "mistral-small-latest"). Use a "-latest" alias or a dated id.
# MISTRAL_MODEL=mistral-small-latest
