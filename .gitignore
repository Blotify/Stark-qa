# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
.python-version

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environment variables (secrets)
.env

# Logs
*.log

# RAG dense-embedding cache (large binary, rebuilt from the JSON index)
*_embeddings.npy

# LaTeX build artifacts (the report PDF is kept; intermediates are not)
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
report/tectonic

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# uv lockfile (environment is pinned via requirements.txt / pyproject.toml)
uv.lock

# Note: the cached dataset splits in cache/*.json are intentionally tracked so
# offline runs are reproducible.

notes/
